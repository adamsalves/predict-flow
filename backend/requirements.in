# Production runtime dependencies (input for pip-compile).
# Compiled to requirements.txt, which is what the Docker image installs.
# scikit-learn and joblib are shared pipeline libraries: training produces
# model.joblib and serving loads it via joblib.load, so both environments
# must resolve the exact same versions (parity enforced by
# scripts/check_dependency_parity.py, see ADR-0017).
fastapi
uvicorn[standard]
sqlalchemy
# alembic applies the domain schema migrations (issue #7); it ships in the
# runtime image so `alembic upgrade head` can run at deploy time.
alembic
psycopg[binary]
pydantic-settings
scikit-learn
joblib
# shap generates local explanations at serving time through the fitted
# Pipeline components (ADR-0001, ADR-0018), so it is a runtime dependency
# shared with training and covered by the parity check.
shap
